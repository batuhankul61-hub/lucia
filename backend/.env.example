# Copy this file to backend/.env and fill in the key. backend/.env is git-ignored.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional overrides
# LIVE_MODEL=gemini-3.8-live
# REPORT_MODEL=gemini-3.5-flash-lite

# Frontend origins allowed by CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Optional: require this code in the X-Access-Code header (protects your free quota)
ACCESS_CODE=

# Set to true when running behind a proxy such as Render
TRUST_PROXY=false
